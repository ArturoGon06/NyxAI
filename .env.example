# The published NyxAI port. Use a private LAN or Tailscale address; do not
# expose local inference backends directly to the public internet.
NYXAI_PORT=8000

# Both paths are inside the persistent Docker /data volume by default.
NYXAI_DATABASE_URL=/data/nyxai.db
NYXAI_ASSET_DIR=/data/avatars

# Set this explicitly for your deployment. Container localhost is the NyxAI
# container, not the Docker host.
OLLAMA_BASE_URL=http://192.168.1.100:11434
# Optional local OpenAI-compatible text server (for example llama.cpp or
# vLLM). This is a fallback until a URL is saved in NyxAI Settings.
OPENAI_COMPATIBLE_BASE_URL=http://192.168.1.100:8080/v1
# Optional; leave unset when the local server has no authentication.
# OPENAI_COMPATIBLE_API_KEY=
A1111_BASE_URL=http://192.168.1.100:7860
NYXAI_IMAGE_DIR=/data/images
